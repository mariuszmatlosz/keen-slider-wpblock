<?xml version="1.0"?>
<ruleset name="Keen Slider WPBlock">
	<description>Human Made minimum coding standards for this plugin.</description>

	<file>plugin.php</file>
	<file>inc</file>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<config name="minimum_supported_wp_version" value="6.3"/>
	<config name="testVersion" value="8.0-"/>
	<config name="text_domain" value="keen-slider-wpblock"/>

	<rule ref="HM-Minimum"/>
</ruleset>
