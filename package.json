{
	"name": "keen-slider-wpblock",
	"version": "1.0.0",
	"private": true,
	"description": "Standalone WordPress block plugin for Keen Slider.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "node scripts/build-vite.mjs && node scripts/prepare-blocks.mjs",
		"build": "node scripts/build-vite.mjs && node scripts/prepare-blocks.mjs && node scripts/sync-to-plugins.mjs",
		"test": "vitest run",
		"lint": "eslint . && stylelint \"src/**/*.scss\" && composer phpcs",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"src/**/*.scss\"",
		"lint:php": "composer phpcs"
	},
	"dependencies": {
		"keen-slider": "^6.8.6"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^8.0.7",
		"@humanmade/eslint-config": "^2.1.0",
		"@humanmade/stylelint-config": "^1.3.0",
		"@vitejs/plugin-react": "^4.7.0",
		"@wordpress/block-editor": "^14.21.0",
		"@wordpress/blocks": "^14.15.0",
		"@wordpress/components": "^29.12.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/eslint-plugin": "^20.3.0",
		"@wordpress/i18n": "^5.26.0",
		"eslint": "^9.39.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^50.8.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"fast-glob": "^3.3.3",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.105.1",
		"stylelint": "^16.26.1",
		"vite": "^6.4.4",
		"vitest": "^5.0.3"
	}
}
